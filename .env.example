# Which LLM to use: "claude", "openai" or "gemini" (gemini has a free tier)
LLM_PROVIDER=claude

# Required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# Required when LLM_PROVIDER=gemini (free key: https://aistudio.google.com/apikey)
# Any *_MODEL setting can list fallback models, separated by commas. The first
# is used normally; the next ones only when a model is overloaded or rate-limited.
# e.g. GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
GEMINI_API_KEY=
GEMINI_MODEL=

# AnkiConnect address on the computer where you open the app in a browser.
# The browser calls it directly, so 127.0.0.1 means "this computer's Anki".
ANKI_USERS=sun:8765,kay:8766
